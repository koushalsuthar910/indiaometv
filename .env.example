# ---------- Server ----------
PORT=4000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-in-production
JWT_SECRET=change-me-too
ADMIN_TOKEN=change-me-admin-token
NODE_ENV=development

# Optional Postgres (server falls back to in-memory store if empty)
DATABASE_URL=

# TURN (optional, comma-separated urls)
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# ---------- Client (Vite) ----------
VITE_API_URL=http://localhost:4000
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
VITE_DEV_PANEL=true
